{
  "schemaVersion": 1,
  "id": "io.github.ianmove.notataker",
  "name": "Notataker",
  "version": "1.0.1",
  "author": "IAnMove",
  "license": "MIT",
  "description": "Capture a screen region and tell your default Omarchy agent what to do with it: transcribe it into your notes, translate it, build what you see…",
  "kinds": ["bar-widget", "overlay"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Notataker",
    "description": "Screenshot + request to your agent",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
